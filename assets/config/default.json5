{
  // kessel default configuration.
  // These are the compiled-in defaults; override them in
  // <app_data_dir>/kessel/config.json5 — same shape, comments welcome.

  ui: {
    theme: "system",       // "light" | "dark" | "system"
    // UI language: "system" resolves from the environment; otherwise a
    // locale tag with a table in assets/i18n/ or <app_data_dir>/i18n/
    // (built-in: "en", "de").
    locale: "system",
    // Named themes, hot-reloaded from <app_data_dir>/themes/*.json (Zed theme
    // files or gpui-component ThemeSet format) and from unpacked Zed theme
    // extensions in <app_data_dir>/extensions/*/themes/*.json.
    // Unset = built-in defaults.
    // light_theme: "One Light",
    // dark_theme: "Material Darker",
    // Zed-compatible icon theme, by theme name, from an unpacked Zed
    // extension in <app_data_dir>/extensions/*/icon_themes/*.json
    // (e.g. material-icon-theme).
    // icon_theme: "Material Icon Theme",
    // Zed-style theme overrides: theme name → Zed style keys merged over
    // that theme before conversion. Same shape as Zed's "theme_overrides".
    // theme_overrides: {
    //   "Material Darker": { "border": "#1A1A1A" },
    // },
    show_hidden: false,
    sidebar_position: "left", // vertical tabs sidebar: "left" | "right"
    // Default file-list columns per backend scheme; "default" covers any
    // scheme without its own entry. Name always shows.
    // Available: "size", "modified", plus provider-specific columns that
    // only apply where the backend can fill them:
    //   "permissions"   — unix mode (fs, sftp)
    //   "storage_class" — S3 storage class (s3)
    //   "region"        — bucket region on account-root S3 listings (s3)
    columns: {
      default: ["size", "modified"],
      // s3: ["size", "modified", "storage_class"],
      // sftp: ["size", "modified", "permissions"],
    },
    // Panel sizes in px. Dragging a divider persists the live value back
    // into <app_data_dir>/kessel/config.json5 (comments are preserved).
    // Every value in this file hot-reloads while the app is running.
    sidebar_width: 220,
    dock_height: 240,    // shared bottom dock: Transfers (cmd-j) / Logs (cmd-alt-j)
    split_h_width: 500,  // first pane width in a horizontal split
    split_v_height: 300, // first pane height in a vertical split
    // Per-pane folder tree (cmd-shift-e): default visibility for new panes
    // and its width (drag its divider; the value is written back here).
    tree_visible: false,
    tree_width: 180,
  },

  transfers: {
    // Global cap on concurrently running transfer tasks across all sites.
    max_parallel: 4,
    // Global bandwidth limit in bytes/sec; 0 = unlimited. Applied as the
    // default per-site OpenDAL throttle wherever a site doesn't set its own.
    bandwidth_limit: 0,
    // Extra attempts per file after its first failure (on top of the
    // per-operation retries OpenDAL's RetryLayer already does).
    retries: 2,
    // Post-transfer verification: re-stat the destination and compare sizes
    // (and etags where they are comparable).
    verify: true,
    // Copy the source's modified time onto the destination where the backend
    // allows it (local fs, sftp). Object stores can't set mtime.
    preserve_timestamps: true,
    // Leave hidden files (dotfiles) out when a directory is expanded into
    // per-file transfer tasks.
    skip_hidden: false,
    // What a transfer started from a file pane does when the destination file
    // already exists: "ask" (park it and ask), "replace", "skip", "keep_both"
    // (write under a unique name) or "replace_if_newer".
    default_conflict_policy: "ask",
  },

  // Default OpenDAL layer stack applied to every site unless the site
  // overrides it in its bookmark.
  layers: {
    retry: {
      max_times: 4,
      min_delay_ms: 250,
      max_delay_ms: 10000,
    },
    timeout_secs: 60,
    concurrent_limit: 8,
    // throttle: { bandwidth: 1048576, burst: 2097152 }, // bytes/sec, uncomment to cap per-site
  },

  logging: {
    // tracing filter directive, e.g. "kessel=debug,opendal=info"
    filter: "kessel=info,opendal=warn",
  },

  // Embedded MCP (Model Context Protocol) server. Exposes kessel's sites,
  // directory listings and the transfer queue to MCP clients (e.g. Claude)
  // over a local streamable-HTTP endpoint. Off by default; changes here take
  // effect on the next app start (not hot-reloaded).
  //
  // Connect a client to:  http://127.0.0.1:39100/mcp
  //   claude mcp add --transport http kessel http://127.0.0.1:39100/mcp
  //
  // SECURITY: there is no authentication in v1. Keep `bind` on loopback, and
  // only enable `expose_write` on a machine you trust — it unlocks tools that
  // enqueue, pause, resume and cancel transfers.
  mcp: {
    enabled: false,       // master switch
    port: 39100,
    bind: "127.0.0.1",    // loopback only; non-loopback binds log a warning
    expose_write: false,  // gate mutating tools (enqueue/pause/resume/cancel)
  },

  // In-app auto-update. kessel checks a stable release manifest on GitHub at
  // startup and once every 24h, downloads the new build when there is one, and
  // verifies its SHA-256 before installing: the .app bundle is swapped in place
  // on macOS, the .exe on Windows. When the install location isn't writable the
  // download is revealed in Finder / Explorer for a manual install instead. The
  // manual "Check for updates…" command works regardless of `check`.
  update: {
    check: true,          // background check at startup and daily
    // Manifest URL. Left unset it resolves to the newest release's manifest for
    // the platform this build runs on — latest.json (macOS) or
    // latest-windows.json. Set it only to pin a different release channel.
    // url: "https://github.com/coderscantina/kessel/releases/latest/download/latest.json",
  },
}
